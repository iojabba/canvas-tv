<?xml version="1.0" encoding="utf-8"?>
<!-- Only listens for Google TV's home screen coming to the front; reads no screen content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:packageNames="com.google.android.apps.tv.launcherx,com.google.android.tvlauncher,com.google.android.leanbacklauncher"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/home_helper_description" />
